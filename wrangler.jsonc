
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "govflow-ai",
  "compatibility_date": "2026-11-16",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/worker.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/health"]
  }
}
